{
  "expo": {
    "name": "FConline Ground",
    "slug": "fconline-ground",
    "version": "0.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fconlineground",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0f3f5",
      "dark": {
        "image": "./assets/images/splash-logo-dark.png",
        "backgroundColor": "#121318"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fcoground.app",
      "splash": {
        "image": "./assets/images/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#f0f3f5",
        "dark": {
          "image": "./assets/images/splash-logo-dark.png",
          "backgroundColor": "#121318"
        }
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f0f3f5"
      },
      "package": "com.fcoground.app",
      "versionCode": 2026052602,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/images/splash-logo-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#f0f3f5",
        "dark": {
          "image": "./assets/images/splash-logo-android-dark.png",
          "backgroundColor": "#121318"
        }
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo-android.png",
          "imageWidth": 144,
          "resizeMode": "contain",
          "backgroundColor": "#f0f3f5",
          "dark": {
            "image": "./assets/images/splash-logo-android-dark.png",
            "backgroundColor": "#121318"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PretendardVariable.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Thin.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./assets/fonts/Pretendard-ExtraLight.ttf",
                    "weight": 200
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Pretendard-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Pretendard-ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#256ef4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcbf4efe-5968-40ab-b8d9-af3518374baa"
      }
    },
    "owner": "uxx",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fcbf4efe-5968-40ab-b8d9-af3518374baa"
    }
  }
}
